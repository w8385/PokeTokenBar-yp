{
  "display_information": {
    "name": "YPoke",
    "description": "PokeTokenBar 포켓몬 대결 봇",
    "background_color": "#2c303a"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "YPoke",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/대결",
        "description": "포켓몬 대결. 기본 1:1, 1~6을 붙이면 그 수만큼, @YPoke는 연습",
        "usage_hint": "@상대 [1-6]",
        "should_escape": true
      },
      {
        "command": "/포켓몬연결",
        "description": "PokeTokenBar 앱 연결 링크를 DM으로 받기",
        "should_escape": true
      },
      {
        "command": "/전적",
        "description": "승패 보기",
        "usage_hint": "[@누구]",
        "should_escape": true
      },
      {
        "command": "/랭킹",
        "description": "이번 주 승리 순위",
        "should_escape": true
      },
      {
        "command": "/도감",
        "description": "도감 수·이로치·지역별 진행·대표 포켓몬 보기",
        "usage_hint": "[@누구]",
        "should_escape": true
      },
      {
        "command": "/ypoke",
        "description": "YPoke 도움말. 뒤에 명령을 붙여도 돼요",
        "usage_hint": "[대결 @상대 | 전적 | 랭킹 | 도감 | 연결 | 파티 | 박스 | 가방]",
        "should_escape": true
      },
      {
        "command": "/파티",
        "description": "내 대결 파티의 레벨·성격·특성·도구·기술 보기 (나만 봐요)",
        "should_escape": true
      },
      {
        "command": "/박스",
        "description": "내 박스 포켓몬 보기. 이름으로 찾고 쪽을 넘겨요 (나만 봐요)",
        "usage_hint": "[이름] [쪽]",
        "should_escape": true
      },
      {
        "command": "/가방",
        "description": "쓸 수 있는 토큰·가방 도구·대기 중인 작업 보기 (나만 봐요)",
        "should_escape": true
      },
      {
        "command": "/상점",
        "description": "앱 상점에서 사기. 이름으로 찾아요 (나만 봐요)",
        "usage_hint": "[이름]",
        "should_escape": true
      },
      {
        "command": "/트레이닝",
        "description": "민트·특성캡슐·병뚜껑·흉내허브·폼·기술 트레이닝 (나만 봐요)",
        "usage_hint": "[이름]",
        "should_escape": true
      },
      {
        "command": "/교환",
        "description": "박스 포켓몬으로 동료에게 교환 제안하고 진행 중인 교환 보기 (나만 봐요)",
        "usage_hint": "[@상대] [이름]",
        "should_escape": true
      },
      {
        "command": "/미라클",
        "description": "박스 포켓몬을 미라클 교환에 올리거나 내리기 (나만 봐요)",
        "usage_hint": "[이름]",
        "should_escape": true
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "commands", "chat:write", "channels:join", "channels:write.topic", "files:write", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
