# Copy to ~/ypoke/.env on the bot host. install.sh sets mode 600.

# Slack app tokens for Socket Mode. The bot token starts with xoxb, the app-level token with xapp.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# How the app reaches the upload server. Sent in the /포켓몬연결 link.
YPOKE_PUBLIC_URL=http://<bot-host>:8790

# Upload server bind address and port.
YPOKE_HTTP_HOST=0.0.0.0
YPOKE_HTTP_PORT=8790

# Optional public channel id for battles. The bot joins it at startup; help links to it.
YPOKE_HOME_CHANNEL=
